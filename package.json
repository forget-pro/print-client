{
  "name": "pic-print",
  "version": "1.2.3",
  "main": "dist-electron/main/index.js",
  "description": "Really simple Electron + Vue + Vite boilerplate.",
  "author": "Forget <781306919@qq.com>",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "h5": "vite build",
    "build": "vue-tsc --noEmit && vite build && electron-builder --win --publish never",
    "build:win": "vue-tsc --noEmit && vite build && electron-builder --win --publish never",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.2",
    "vite": "^5.1.5",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue": "^3.4.21",
    "vue-tsc": "^2.0.6"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.1",
    "electron-updater": "^6.3.9",
    "image-size": "^1.1.1",
    "lodash-es": "^4.17.21",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.15.0",
    "sharp": "^0.33.4",
    "vue-draggable-plus": "^0.5.0",
    "vue-router": "^4.6.4",
    "vue3-preview-image": "^1.2.3"
  }
}
