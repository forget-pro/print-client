{
  "name": "pic-print",
  "version": "1.2.7",
  "main": "dist-electron/main/index.js",
  "description": "图片打印",
  "author": "Forget <781306919@qq.com>",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "h5": "vite build",
    "build": "vue-tsc --noEmit && vite build && electron-builder --win --publish never",
    "build:win": "vue-tsc --noEmit && vite build && electron-builder --win --publish never",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "ant-design-vue": "^4.2.6",
    "electron-updater": "^6.8.9",
    "image-size": "^2.0.4",
    "lodash-es": "^4.18.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.4",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.3.1",
    "vue3-preview-image": "^1.2.3"
  }
}
